# Copy to config/project.env and replace the placeholders.
# Do not commit config/project.env.

FASTQ_DIR="/path/to/fastq"
PROJECT_DIR="/path/to/this/repository"
NXF_WORK_DIR="/path/to/nextflow/work"
SAREK_OUTDIR="/path/to/sarek/results"
SAREK_VERSION="3.10.0"
NXF_PROFILE="docker"
GENOME="GATK.GRCh38"
TARGET_BED_RAW="${PROJECT_DIR}/03_resources/exome2plus_targets_hg38.bed"
TARGET_BED_PADDED="${PROJECT_DIR}/03_resources/exome2plus_targets_hg38.pad100.bed"
BED_PADDING=100
DEFAULT_SEX="XX"
FACETS_SNP_VCF="/path/to/dbsnp_common_hg38.chr.vcf.gz"
FACETS_CVAL=150
THREADS=16

HLATYPING_VERSION="2.2.0"
NXF_HLA_VER="25.04.2"
PVACTOOLS_IMAGE="griffithlab/pvactools:2026-09-29"
VEP_IMAGE="ensemblorg/ensembl-vep:release_116.0"
VEP_CACHE_DIR="/path/to/vep/cache/116_GRCh38"
VEP_CACHE_VERSION="116"
REFERENCE_FASTA="/path/to/Homo_sapiens_assembly38.fasta"
VEP_PLUGIN_DIR="${PROJECT_DIR}/14_immune/neoantigens/vep_plugins"
NEOAG_ALGORITHMS="MHCflurry"
NEOAG_IC50_CUTOFF=500

PY="python3"
