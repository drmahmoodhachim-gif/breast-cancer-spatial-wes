process {
    resourceLimits = [ cpus: 10, memory: 12.GB, time: 72.h ]
    stageInMode = 'symlink'
    // 12 GB: a 10 GB cap killed samtools sort on DH00023_N (truncated file)
    withName: '.*:BWAMEM.*|.*:BWAMEM2.*|.*BWA_MEM.*' {
        cpus = 8
        memory = 12.GB
        errorStrategy = 'retry'
        maxRetries = 2
    }
    withName: '.*:FASTQC.*' {
        cpus = 2
        memory = 3.GB
    }
    withName: '.*:FASTP.*' {
        cpus = 4
        memory = 4.GB
    }
    withName: '.*MARKDUPLICATES.*|.*MarkDuplicates.*' {
        cpus = 6
        memory = 10.GB
        errorStrategy = 'retry'
        maxRetries = 1
    }
    withName: '.*MUTECT2.*|.*HAPLOTYPECALLER.*|.*STRELKA.*|.*BASERECALIBRATOR.*|.*APPLYBQSR.*' {
        cpus = 6
        memory = 10.GB
    }
}
executor {
    queueSize = 1
}
