// Resource cap for nf-core/hlatyping on a ~16-18 GB workstation.
// resourceLimits clips any process request (e.g. FastQC asking for 36 GB) to what the machine has.
process {
    resourceLimits = [ cpus: 8, memory: 14.GB, time: 24.h ]
}
// One sample at a time keeps memory and disk I/O predictable; raise if the machine is idle.
executor {
    queueSize = 2
}
